# OpenAI 兼容 API（可填官方或代理）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 可选：默认系统提示（留空则使用内置简短设定）
SYSTEM_PROMPT=

# SQLite 数据库路径（相对项目根目录）
DATABASE_PATH=data/app.db

# 服务
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 第二周：工具
# 允许读文件的根目录（逗号分隔，相对项目根）；留空 = 仅项目根目录
TOOL_FILE_ROOTS=
# 允许 http_get 的主机名（逗号分隔，小写）；留空 = 不注册 http_get；填 * 表示任意主机（慎用）
TOOL_HTTP_ALLOWED_HOSTS=
TOOL_HTTP_TIMEOUT_SEC=15
TOOL_HTTP_MAX_BYTES=500000
TOOL_MAX_FILE_BYTES=200000
AGENT_MAX_TOOL_ROUNDS=8

# 第三周：会话摘要 + 长期向量记忆
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_ENABLED=true
MEMORY_SESSION_SUMMARY=true
MEMORY_LONG_TERM=true
MEMORY_KEEP_RECENT_MESSAGES=12
MEMORY_SUMMARIZE_OVER_MESSAGES=24
MEMORY_RETRIEVE_TOP_K=5
MEMORY_MIN_SCORE=0.35
MEMORY_INDEX_MAX_CHARS=4000
MEMORY_SEARCH_POOL=500
MEMORY_INDEX_EXTENSIONS=.md,.txt,.markdown
MEMORY_INDEX_CHUNK_CHARS=1500

# 第四周：产品化
AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini

# 第五周：鉴权与定时任务
# 设为 true 后除 /、/health、/api/config 外均需 API Key
AUTH_ENABLED=false
# 逗号分隔的启动密钥（与数据库密钥二选一或并用）
API_KEYS=
AUTH_HEADER_NAME=X-API-Key
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
